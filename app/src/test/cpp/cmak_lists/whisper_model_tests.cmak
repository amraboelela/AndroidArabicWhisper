cmake_minimum_required(VERSION 3.10)
project(arabicwhisper_model_tests)

# Set C++ standard
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Include directories
set(CTRANSLATE2_ROOT "/Users/amraboelela/develop/android/CTranslate2")
include_directories(${CTRANSLATE2_ROOT}/include)
include_directories(../../../main/cpp/include)
include_directories(../../../main/cpp/whisper)

# Find required packages
find_package(ZLIB REQUIRED)

# Find CTranslate2 library (try multiple possible locations)
find_library(CTRANSLATE2_LIB
  NAMES ctranslate2 libctranslate2.so
  PATHS
    ${CTRANSLATE2_ROOT}/lib
    ${CTRANSLATE2_ROOT}/build/lib
    ${CTRANSLATE2_ROOT}/build-android-arm64
  NO_DEFAULT_PATH
)

# Set up source files - always include the real whisper_model.cpp
set(WHISPER_MODEL_SOURCES
    ../whisper_model_tests.cpp
    ../../../main/cpp/whisper_model.cpp
    ../../../main/cpp/feature_extractor.cpp
    ../../../main/cpp/audio_decoder.cpp
    ../../../main/cpp/tokenizer.cpp
    ../../../main/cpp/utils.cpp
    ../../../main/cpp/whisper/whisper_audio.cpp
    ../../../main/cpp/whisper/whisper_tokenizer.cpp
)

# Create test executable for WhisperModel tests
add_executable(test_whisper_model ${WHISPER_MODEL_SOURCES})

# Link libraries for test
target_link_libraries(
    test_whisper_model
    ${ZLIB_LIBRARIES}
    m  # math library
)

# Configure CTranslate2 linking
if(CTRANSLATE2_LIB)
    message(STATUS "Found CTranslate2: ${CTRANSLATE2_LIB}")
    target_link_libraries(test_whisper_model ${CTRANSLATE2_LIB})
    target_compile_definitions(test_whisper_model PRIVATE HAVE_CTRANSLATE2)

    # Add additional libraries that CTranslate2 might need
    find_library(ACCELERATE_FRAMEWORK Accelerate)
    if(ACCELERATE_FRAMEWORK)
        target_link_libraries(test_whisper_model ${ACCELERATE_FRAMEWORK})
    endif()

    # Add pthread if needed
    find_package(Threads REQUIRED)
    target_link_libraries(test_whisper_model Threads::Threads)

else()
    message(FATAL_ERROR "CTranslate2 library not found! Please ensure CTranslate2 is built.")
endif()

# Enable testing
enable_testing()

# Add the test
add_test(NAME whisper_model_test COMMAND test_whisper_model)

# Print instructions
message(STATUS "To run WhisperModel tests:")
message(STATUS "  mkdir build && cd build")
message(STATUS "  cp ../whisper_model_tests.cmak ./CMakeLists.txt")
message(STATUS "  cmake .")
message(STATUS "  make")
message(STATUS "  ./test_whisper_model")
message(STATUS "  OR: make test")